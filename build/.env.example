# 网关根地址，不带尾斜杠。
MERCHANT_BASE_URL=http://xxx:8080
# 留空则直连业务服务（本地调试用）。
MERCHANT_GATEWAY_PREFIX=/api/merchant

# 登录代理的地址。
IDENTITY_BASE_URL=http://1.14.205.214:8080/api/identity/

# AI 调业务接口用的 JWT（不是用户 token，是服务账号）。
MERCHANT_SERVICE_TOKEN=

# 刷新上面那枚 token 用的服务账号。
SERVICE_USER=
SERVICE_PASSWORD=

# ---------- JWT 校验 ----------

# 必须和云上 Identity 实际签出来的 iss 一致。
JWT_ISSUER=
JWT_KEY=

# ---------- 模型 ----------
DEEPSEEK_API_KEY=
DEEPSEEK_ENDPOINT=
DEEPSEEK_MODEL=

# ---------- AI 自己的 Redis ----------

# 默认走 compose 里的 ai-redis 容器。想接外部 Redis 就改成
# host:port,password=xxx,abortConnect=false 并把下面 ai-redis 服务停掉。
REDIS_CONNECTION=ai-redis:6379,abortConnect=false

# ---------- 对外访问 ----------

# 宿主机端口。云上如果已经有 nginx 占了 80/443，就让它反代到这个端口。
HTTP_PORT=

# 浏览器实际访问 AI 前端的地址，用于 CORS 白名单。
PUBLIC_ORIGIN=

# 镜像 tag，方便回滚
IMAGE_TAG=latest
